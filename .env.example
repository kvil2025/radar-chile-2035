# ==============================================================================
# RADAR CHILE 2035 — Environment Variables Configuration
# ==============================================================================

# Project
PROJECT_NAME="RADAR CHILE 2035"
ENVIRONMENT=development
DEBUG=True
VERSION=1.0.0

# Database (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./radar_chile.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=radar_chile
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# External Data API Credentials (Optional - calibrated fallbacks provided)
FRED_API_KEY=
BANCO_CENTRAL_USER=
BANCO_CENTRAL_PASS=
GEMINI_API_KEY=

# Security
API_SECRET_KEY=radar-chile-2035-secure-token-development-secret-key
DEFAULT_METHODOLOGY_VERSION=v0.1
